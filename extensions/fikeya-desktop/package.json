{
	"name": "fikeya-desktop",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0-beta.5",
	"publisher": "fikeya",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/AjnasNB/fikeya.git",
		"directory": "extensions/fikeya-desktop"
	},
	"engines": {
		"vscode": "^1.110.0"
	},
	"categories": [
		"Other"
	],
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false,
			"description": "%capabilities.untrustedWorkspaces%"
		}
	},
	"activationEvents": [
		"onStartupFinished",
		"onView:fikeya.dashboard",
		"onCommand:fikeya.open",
		"onCommand:fikeya.chat.toggle",
		"onCommand:fikeya.configureProvider",
		"onCommand:fikeya.configureAgents",
		"onCommand:fikeya.initializeWorkspace",
		"onCommand:fikeya.runDoctor",
		"onCommand:fikeya.mode.research",
		"onCommand:fikeya.view.usage",
		"onCommand:fikeya.view.setup"
	],
	"main": "./out/extension",
	"contributes": {
		"viewsContainers": {
			"secondarySidebar": [
				{
					"id": "fikeya",
					"icon": "media/fikeya.svg",
					"title": "%container.title%"
				}
			]
		},
		"views": {
			"fikeya": [
				{
					"id": "fikeya.dashboard",
					"name": "%view.dashboard.name%",
					"type": "webview",
					"contextualTitle": "%view.dashboard.contextualTitle%"
				}
			]
		},
		"commands": [
			{
				"command": "fikeya.open",
				"title": "%command.open.title%",
				"category": "%command.category%",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "fikeya.chat.toggle",
				"title": "%command.chat.toggle.title%",
				"category": "%command.category%",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "fikeya.layout.project",
				"title": "%command.layout.project.title%",
				"category": "%command.category%",
				"icon": "$(layout-centered)"
			},
			{
				"command": "fikeya.layout.editor",
				"title": "%command.layout.editor.title%",
				"category": "%command.category%",
				"icon": "$(layout-sidebar-right)"
			},
			{
				"command": "fikeya.configureProvider",
				"title": "%command.configureProvider.title%",
				"category": "%command.category%",
				"icon": "$(key)"
			},
			{
				"command": "fikeya.configureAgents",
				"title": "%command.configureAgents.title%",
				"category": "%command.category%",
				"icon": "$(organization)"
			},
			{
				"command": "fikeya.chat.deleteSavedHistory",
				"title": "%command.chat.deleteSavedHistory.title%",
				"category": "%command.category%",
				"icon": "$(trash)"
			},
			{
				"command": "fikeya.initializeWorkspace",
				"title": "%command.initializeWorkspace.title%",
				"category": "%command.category%",
				"icon": "$(database)"
			},
			{
				"command": "fikeya.runDoctor",
				"title": "%command.runDoctor.title%",
				"category": "%command.category%",
				"icon": "$(pulse)"
			},
			{
				"command": "fikeya.mode.editor",
				"title": "%command.mode.editor.title%",
				"category": "%command.category%",
				"enablement": "fikeya.supportsDesktopWorkbench"
			},
			{
				"command": "fikeya.mode.agent",
				"title": "%command.mode.agent.title%",
				"category": "%command.category%",
				"enablement": "fikeya.supportsDesktopWorkbench"
			},
			{
				"command": "fikeya.mode.terminal",
				"title": "%command.mode.terminal.title%",
				"category": "%command.category%",
				"enablement": "fikeya.supportsDesktopWorkbench"
			},
			{
				"command": "fikeya.mode.review",
				"title": "%command.mode.review.title%",
				"category": "%command.category%",
				"enablement": "fikeya.supportsDesktopWorkbench"
			},
			{
				"command": "fikeya.mode.lab",
				"title": "%command.mode.lab.title%",
				"category": "%command.category%",
				"enablement": "fikeya.supportsDesktopWorkbench"
			},
			{
				"command": "fikeya.view.usage",
				"title": "%command.view.usage.title%",
				"category": "%command.category%"
			},
			{
				"command": "fikeya.view.setup",
				"title": "%command.view.setup.title%",
				"category": "%command.category%"
			},
			{
				"command": "fikeya.mode.research",
				"title": "%command.mode.research.title%",
				"category": "%command.category%",
				"enablement": "fikeya.supportsDesktopWorkbench"
			}
		],
		"configuration": {
			"title": "Fikeya",
			"properties": {
				"fikeya.startupMode": {
					"type": "string",
					"enum": [
						"project",
						"editor",
						"none"
					],
					"enumDescriptions": [
						"Open the Codex-style Project UI.",
						"Open the editor with Fikeya Chat in the right pane.",
						"Restore the native workbench without opening Fikeya."
					],
					"default": "project",
					"scope": "window",
					"description": "%configuration.startupMode.description%"
				},
				"fikeya.chat.openAtStartup": {
					"type": "boolean",
					"default": true,
					"scope": "window",
					"description": "%configuration.chat.openAtStartup.description%"
				},
				"fikeya.chat.persistWorkspaceHistory": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"description": "%configuration.chat.persistWorkspaceHistory.description%"
				},
				"fikeya.agent.autoSaveWorkspaceEdits": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%configuration.agent.autoSaveWorkspaceEdits.description%"
				}
			}
		},
		"keybindings": [
			{
				"command": "fikeya.chat.toggle",
				"key": "ctrl+l",
				"mac": "cmd+l",
				"when": "fikeya.isFikeyaProduct"
			},
			{
				"command": "fikeya.open",
				"key": "ctrl+alt+l",
				"mac": "cmd+alt+l"
			},
			{
				"command": "fikeya.open",
				"key": "ctrl+alt+i",
				"mac": "cmd+alt+i"
			},
			{
				"command": "fikeya.mode.lab",
				"key": "ctrl+alt+g",
				"mac": "cmd+alt+g"
			}
		],
		"themes": [
			{
				"label": "Fikeya Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/fikeya-dark-color-theme.json"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "fikeya.chat.toggle",
					"when": "fikeya.supportsDesktopWorkbench && activeWebviewPanelId != fikeya.workspace",
					"group": "navigation@19"
				},
				{
					"command": "fikeya.layout.editor",
					"when": "activeWebviewPanelId == fikeya.workspace",
					"group": "navigation@20"
				}
			],
			"view/title": [
				{
					"command": "fikeya.layout.project",
					"when": "view == fikeya.dashboard",
					"group": "navigation@1"
				},
				{
					"command": "fikeya.runDoctor",
					"when": "view == fikeya.dashboard",
					"group": "navigation@2"
				}
			]
		}
	},
	"scripts": {
		"build:protocol": "npm ci --ignore-scripts --prefix ../../packages/fikeya-protocol && npm run build --prefix ../../packages/fikeya-protocol",
		"precompile": "npm run build:protocol",
		"compile": "tsc --project ./tsconfig.json",
		"watch": "tsc --project ./tsconfig.json --watch",
		"pretypecheck": "npm run build:protocol",
		"typecheck": "tsc --project ./tsconfig.json --noEmit",
		"test": "npm run typecheck && tsc --project ./tsconfig.json && node --test ./out/test/agentProfiles.test.js ./out/test/azureDiscovery.test.js ./out/test/conversation.test.js ./out/test/fileInputs.test.js ./out/test/hostCapabilities.test.js ./out/test/markdown.test.js ./out/test/messageValidation.test.js ./out/test/multiAgent.test.js ./out/test/runtime.test.js ./out/test/memory.test.js ./out/test/sessionCapture.test.js ./out/test/surface.test.js ./out/test/teamLead.test.js",
		"build:vsix": "npm test && node ./scripts/package-extension.mjs",
		"check:vsix": "node ./scripts/inspect-vsix.mjs",
		"test:isolated-vsix": "node ./scripts/test-isolated-vsix.mjs",
		"package:vsix": "npm run build:vsix && npm run check:vsix && npm run test:isolated-vsix"
	},
	"devDependencies": {
		"@fikeya/protocol": "file:../../packages/fikeya-protocol",
		"@types/node": "24.x",
		"@vscode/vsce": "3.9.2",
		"esbuild": "0.28.1",
		"qarinah": "0.4.0",
		"typescript": "^5.9.3",
		"yauzl": "3.2.1"
	}
}
