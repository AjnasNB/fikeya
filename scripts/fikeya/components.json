{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"schemaVersion": 1,
	"channel": "public-beta",
	"requirements": {
		"node": {
			"allowedMajors": [22, 24, 26],
			"minimumByMajor": {
				"22": "22.13.0"
			}
		},
		"python": {
			"minimum": "3.10.0",
			"maximumExclusive": "4.0.0"
		}
	},
	"components": [
		{
			"id": "agent-core",
			"kind": "python",
			"path": "fikeya-agent-core",
			"version": "0.1.0b5",
			"verify": "python -c \"import fikeya_agent_core\""
		},
		{
			"id": "protocol",
			"kind": "npm",
			"path": "packages/fikeya-protocol",
			"version": "0.1.0",
			"lock": "packages/fikeya-protocol/package-lock.json",
			"verify": "npm test"
		},
		{
			"id": "qarinah-sidecar",
			"kind": "npm",
			"path": "integrations/qarinah-sidecar",
			"version": "0.1.0",
			"lock": "integrations/qarinah-sidecar/package-lock.json",
			"verify": "npm test"
		},
		{
			"id": "runtime",
			"kind": "python",
			"path": "fikeya-runtime",
			"version": "0.1.0b5",
			"extra": "azure,browser",
			"constraints": "scripts/fikeya/runtime-constraints.txt",
			"verify": "fikeya --help"
		}
	]
}
